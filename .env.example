# .env.example — copy to .env and fill in real values

# ClickHouse Cloud
CLICKHOUSE_HOST=your-service.us-east1.gcp.clickhouse.cloud
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=your_password_here
CLICKHOUSE_DB=studio_crisis

# Google Cloud
GOOGLE_CLOUD_PROJECT=studio-crisis-cmd
GOOGLE_CLOUD_LOCATION=us-east1
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# TMDB (data source — not an AI tool per hackathon rules)
# Get a key at https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# Kaggle (unused — TMDB catalog is fetched via direct URL)
# KAGGLE_USERNAME=
# KAGGLE_KEY=