# .env.example — copy to .env and fill in real values

# ClickHouse Cloud
CLICKHOUSE_HOST=your-service.us-east1.gcp.clickhouse.cloud
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=your_password_here
CLICKHOUSE_DB=studio_crisis

# Google Cloud (Vertex + service-account path used by google-cloud-aiplatform)
GOOGLE_CLOUD_PROJECT=studio-crisis-cmd
GOOGLE_CLOUD_LOCATION=us-east1
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Gemini API key — google-genai reads this env var directly. Required by
# backend/data/generate_text.py and the Layer 4 pipeline. Also mapped from
# Secret Manager into Cloud Run at deploy time (see scripts/deploy_backend.sh).
GEMINI_API_KEY=your_gemini_api_key_here

# Optional Gemini overrides — leave unset to use defaults.
# GEMINI_MODEL=gemini-2.5-flash

# TMDB (data source — not an AI tool per hackathon rules)
# Get a key at https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# Kaggle (unused — TMDB catalog is fetched via direct URL)
# KAGGLE_USERNAME=
# KAGGLE_KEY=

# ── Layer 6: deploy + eval ─────────────────────────────────────────────
# Deploy scripts (scripts/deploy_*.sh, scripts/warmup_scheduler.sh) require
# GCP_PROJECT. GCP_REGION defaults to us-east1 when unset.
GCP_PROJECT=studio-crisis-cmd-505703
GCP_REGION=us-east1

# Eval CLIs (scripts/eval_{live,record}.py) point here for HTTP + SSE.
# Defaults to http://127.0.0.1:8000 when unset; override for Cloud Run runs.
EVAL_BACKEND_URL=http://127.0.0.1:8000

# FastAPI CORS — comma-separated origins. "*" is fine for local dev; set
# explicitly (e.g. https://scc-frontend-<hash>.a.run.app) in Cloud Run via
# scripts/deploy_backend.sh once the frontend URL is known.
# CORS_ORIGINS=*